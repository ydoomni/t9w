<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="ec0f-6e55-5e48-b353" name="混沌勇士" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="41f2-7aad-bac3-2da8" name="混沌勇士种族规则 2026 beta3" shortName="WC-2026β3" publicationDate="2026-07-01" />
  </publications>
  <sharedRules>
    <rule id="6fa0-425d-9e47-f83c" name="邪神印记" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="2">
      <description>普通模型须具有相同印记；人物加入单位及不同印记人物共处限制见军书第2页。</description>
    </rule>
    <rule id="9ca5-417a-a091-5bec" name="统合混沌印记" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="2">
      <description>纯统合混沌印记单位获得取小掷骰(领导力测试)。</description>
    </rule>
    <rule id="b914-c8f5-97ab-64e0" name="邪神凝视" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="3">
      <description>重投失败战败测试，并按决斗击杀或击杀巨型模型触发邪神凝视表。</description>
    </rule>
    <rule id="d56f-4599-2cb9-0a32" name="战斗狂热" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="3">
      <description>按军书第3页根据生命值损失强化单位。</description>
    </rule>
    <rule id="02eb-26ba-a97c-ff19" name="传说巨兽" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="4">
      <description>军队中传说巨兽括号数值之和受军书规定上限约束。</description>
    </rule>
    <rule id="37e7-afae-3757-9150" name="荣耀旌旗" hidden="false" publicationId="41f2-7aad-bac3-2da8" page="4">
      <description>按军书第4页提供邪神凝视与附近友军增益。</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
