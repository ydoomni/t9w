<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="54bf-e60f-7e18-f601" name="木精灵" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="797b-f77a-9090-b22f" name="木精灵种族规则 2026 beta2" shortName="WE-2026β2" publicationDate="2026-06-01" />
  </publications>
  <sharedRules>
    <rule id="8073-4f30-d012-14bf" name="森林增生" hidden="false" publicationId="797b-f77a-9090-b22f" page="2">
      <description>部署后按军书第2页放置一块己方树林；所有树林对所有模型视为危险地形(1)。</description>
    </rule>
    <rule id="9f4c-89df-c13c-59fb" name="林地居民" hidden="false" publicationId="797b-f77a-9090-b22f" page="2">
      <description>获得行者(树林)，并在树林内获得军书所列近战造伤重投。</description>
    </rule>
    <rule id="7c60-6f38-fbe3-4ad5" name="森林精魂" hidden="false" publicationId="797b-f77a-9090-b22f" page="2">
      <description>获得魔法攻击、无畏和孤傲(森林精魂)。</description>
    </rule>
    <rule id="8f5a-fef6-1268-b19e" name="森林吟唱" hidden="false" publicationId="797b-f77a-9090-b22f" page="2">
      <description>魔法阶段可消耗魔能印记移动附近未接触单位的树林。</description>
    </rule>
  </sharedRules>
