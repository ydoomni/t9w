<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="c2e0-8e2c-b62e-2bb6" name="混沌矮人" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="351f-c173-e5bc-ff86" name="混沌矮人种族规则 2026 beta2" shortName="CD-2026β2" publicationDate="2026-06-01" />
  </publications>
  <sharedRules>
    <rule id="d001-76c0-35f7-858f" name="工业之火(X)" hidden="false" publicationId="351f-c173-e5bc-ff86" page="2">
      <description>军队中所有工业之火数值之和每750分至多1点，向上取整。</description>
    </rule>
    <rule id="0c18-5bd7-8d2a-5a84" name="地狱束缚" hidden="false" publicationId="351f-c173-e5bc-ff86" page="2">
      <description>使用军书第2页的专属发射事故结果。</description>
    </rule>
    <rule id="f491-8fa8-35ac-5e0e" name="蔑视异类" hidden="false" publicationId="351f-c173-e5bc-ff86" page="2">
      <description>获得孤傲与对炮灰鼓舞人心，并强化首次未冲锋近战失败时的坚定不移。</description>
    </rule>
    <rule id="34f5-93a0-ebaf-9815" name="火油" hidden="false" publicationId="351f-c173-e5bc-ff86" page="3">
      <description>火油标记令单位易燃，并按军书第3页在受到火焰攻击伤害后移除。</description>
    </rule>
    <rule id="acb4-8ba2-1834-6450" name="无印" hidden="false" publicationId="351f-c173-e5bc-ff86" page="3">
      <description>不能选择种族特殊物品或哈苏特系，且受加入单位限制。</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
