<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="7d37-86a1-5ee2-e73a" name="矮人群山王国" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="4edc-8601-9d24-711c" name="矮人群山王国种族规则 2026 beta2" shortName="DH-2026β2" publicationDate="2026-06-01" />
  </publications>
  <sharedRules>
    <rule id="1e50-221c-63bb-b880" name="群山之子" hidden="false" publicationId="4edc-8601-9d24-711c" page="2">
      <description>只要己方本军书模型仍在场，敌方法术施法值+1。</description>
    </rule>
    <rule id="8d59-a08e-55b6-eca3" name="亘古仇恨" hidden="false" publicationId="4edc-8601-9d24-711c" page="2">
      <description>按将军仇恨之书、国王和战争王座数量标记敌方仇恨目标。</description>
    </rule>
    <rule id="9725-0111-d418-a916" name="盾墙" hidden="false" publicationId="4edc-8601-9d24-711c" page="2">
      <description>使用盾牌时获得对普通攻击魔盾，并在正面抗冲锋时强化。</description>
    </rule>
    <rule id="4076-c744-ddeb-8e0f" name="刚毅果决" hidden="false" publicationId="4edc-8601-9d24-711c" page="3">
      <description>获得毁灭冲锋(+1力量，+1AP)与稳定瞄准。</description>
    </rule>
    <rule id="8ef0-ae5e-139d-d470" name="屠夫誓言" hidden="false" publicationId="4edc-8601-9d24-711c" page="3">
      <description>遵守阵型限制并按军书第3页进行临死攻击。</description>
    </rule>
    <rule id="971b-ed91-4f4a-b660" name="矮人符文" hidden="false" publicationId="4edc-8601-9d24-711c" page="4">
      <description>除通用旗帜外不能选通用特殊物品；符文组合与每件物品上限见第4-6页。</description>
    </rule>
  </sharedRules>
