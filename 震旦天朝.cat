<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="81c8-c7cf-c419-e66d" name="震旦天朝" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="246c-b89f-04ce-0a7b" name="震旦天朝种族规则 2026 beta3" shortName="CT-2026β3" publicationDate="2026-06-25" />
  </publications>
  <sharedRules>
    <rule id="99f0-a246-0e7d-9ab8" name="阴与阳" hidden="false" publicationId="246c-b89f-04ce-0a7b" page="2">
      <description>异属性友军在6英寸内互相激活宁和；人物加入单位须遵守阴阳属性限制。</description>
    </rule>
    <rule id="fd61-8562-2ea4-c5f4" name="宁和(X)" hidden="false" publicationId="246c-b89f-04ce-0a7b" page="2">
      <description>被激活后获得括号内的规则或属性修正。</description>
    </rule>
    <rule id="77d5-4347-d76e-5ddf" name="龙血" hidden="false" publicationId="246c-b89f-04ce-0a7b" page="2">
      <description>单位获得无畏并重投失败重整；龙血队长额外获得生命值。</description>
    </rule>
    <rule id="7f15-1d29-466e-8dfa" name="精气之风精通" hidden="false" publicationId="246c-b89f-04ce-0a7b" page="2">
      <description>法师可按军队中精通模型数量重投自然结果为1的施法骰。</description>
    </rule>
    <rule id="faca-7fca-903a-e749" name="龙之意志" hidden="false" publicationId="246c-b89f-04ce-0a7b" page="2">
      <description>单位自动通过恐慌测试。</description>
    </rule>
  </sharedRules>
