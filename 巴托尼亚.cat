<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<catalogue xmlns="http://www.battlescribe.net/schema/catalogueSchema" id="3fe8-df90-5e1d-f9d6" name="巴托尼亚" revision="1" battleScribeVersion="2.03" authorName="Custom Rules Data Team" library="false" gameSystemId="9e00-2026-0000-0001" gameSystemRevision="1" type="catalogue">
  <publications>
    <publication id="195f-3138-b3f8-2115" name="巴托尼亚种族规则 2026 beta2" shortName="BR-2026β2" publicationDate="2026-06-01" />
  </publications>
  <sharedRules>
    <rule id="7020-38f4-2cc2-b0ec" name="祈祷" hidden="false" publicationId="195f-3138-b3f8-2115" page="2">
      <description>部署前可选择祈祷并后手开始；高傲骑士获得军书第2页所列保护与冲锋加成。</description>
    </rule>
    <rule id="3a2e-5e0e-f77e-66fe" name="女神祝福" hidden="false" publicationId="195f-3138-b3f8-2115" page="2">
      <description>单位的 Aeg 属性及其失去与恢复方式见军书第2页。</description>
    </rule>
    <rule id="375c-39ea-8b5e-d37e" name="骑士道(X)" hidden="false" publicationId="195f-3138-b3f8-2115" page="3">
      <description>军队骑士道总值上限为每650分1点，向上取整。</description>
    </rule>
    <rule id="2770-17f8-1d62-faa7" name="骑枪阵" hidden="false" publicationId="195f-3138-b3f8-2115" page="3">
      <description>按军书第3页获得额外排面攻击与支援，并遵守对应阵型限制。</description>
    </rule>
  </sharedRules>
